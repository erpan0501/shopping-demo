APP_NAME=智能客服
JAVA_BASE_URL=http://127.0.0.1:8080
JAVA_TIMEOUT_SECONDS=10
# 只对 Java GET 查询的网络错误、429 和 5xx 有限重试。
JAVA_RETRY_ATTEMPTS=3
JAVA_RETRY_DELAY_SECONDS=0.15
# 连续瞬时故障达到阈值后，短时间内快速失败，避免每个客服请求都等待超时。
JAVA_CIRCUIT_FAILURE_THRESHOLD=5
JAVA_CIRCUIT_RECOVERY_SECONDS=30
# 单实例滑动窗口限流。生产多节点时应改为 Redis 限流。
CHAT_RATE_LIMIT_MAX_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
# 生产多实例使用 redis；本地无 Redis 时可用 memory。
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_REDIS_KEY_PREFIX=mall-customer-service:rate-limit
# 本地联调兼容开关；生产环境必须设为 false，只信任商城 JWT 解析出的用户。
ALLOW_TEST_USER_ID=false
AGENT_PORT=8000
AUDIT_DB_PATH=data/customer_service.db

# 仅在接入大模型时填写，不要提交真实密钥
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 内部客服工单接口的访问密钥；生产环境必须设置为高强度随机值
STAFF_API_KEY=

# 会话状态：生产环境使用 Redis；仅本地无 Redis 调试时才设置为 memory。
SESSION_BACKEND=redis
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=mall-customer-service:session
# 无操作 30 分钟后，聊天历史和售后流程状态会一起自动失效。
SESSION_TTL_SECONDS=1800
SESSION_HISTORY_MAX_MESSAGES=10

# Qdrant FAQ 检索默认关闭。设为 qdrant 后，需要配置 OpenAI 兼容嵌入服务。
FAQ_RETRIEVAL_BACKEND=java
FAQ_QDRANT_URL=http://127.0.0.1:6333
FAQ_QDRANT_COLLECTION=mall_faq
FAQ_VECTOR_SCORE_THRESHOLD=0.70
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
